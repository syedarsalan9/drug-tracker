version: '3.8'

services:
  app:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: drug-tracker-app
    restart: unless-stopped
    working_dir: /var/www
    environment:
      - APP_ENV=local
      - APP_DEBUG=true
      - DB_CONNECTION=mysql
      - DB_HOST=db
      - DB_PORT=3306
      - DB_DATABASE=drug_tracker
      - DB_USERNAME=root
      - DB_PASSWORD=secret
    volumes:
      - .:/var/www
    ports:
      - "8000:8000"
    networks:
      - drug-tracker-network
    depends_on:
      - db

  db:
    image: mysql:8.0
    container_name: drug-tracker-db
    restart: unless-stopped
    environment:
      MYSQL_DATABASE: drug_tracker
      MYSQL_ROOT_PASSWORD: secret
    ports:
      - "3307:3306"
    volumes:
      - dbdata:/var/lib/mysql
    networks:
      - drug-tracker-network

networks:
  drug-tracker-network:
    driver: bridge

volumes:
  dbdata:
    driver: local